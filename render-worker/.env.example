SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
SUPABASE_BUCKET=poster-assets
WORKER_ID=node-renderer-1
POLL_MS=2000
LEASE_SECONDS=300
MAX_ATTEMPTS=3

# 字体由环境提供，不随模板入库（PingFang 为 Apple 系统字体，不可分发）
# 本机验证可用 fonttools 从系统 PingFang.ttc 提取；未来 Linux 切换思源黑体只需改这里
RENDER_FONT_REGULAR=/path/to/regular-font.ttf
RENDER_FONT_SEMIBOLD=/path/to/semibold-font.ttf
