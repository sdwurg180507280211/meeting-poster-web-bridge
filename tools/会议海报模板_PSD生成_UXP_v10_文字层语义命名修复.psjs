
/*
 * 会议海报模板 PSD 生成器 v10（UXP / PSJS）
 * 适用：Photoshop 2026（macOS / Windows）
 * 运行：文件 → 脚本 → 浏览…
 *
 * 输入：
 *   1. 无文字底图
 *   2. 带文字参考图
 *   3. PSD 保存位置
 *
 * 输出：
 *   - 原生可编辑文字图层
 *   - 三组可替换头像智能对象（圆形裁切）
 *   - 可替换二维码智能对象
 *   - 左右两组固定尺寸、可替换 Logo 智能对象（圆形剪贴蒙版裁切，更易替换后微调）
 *   - 主标题、副标题可替换智能对象（保留当前 PSD 的原始画布与位置）
 *   - 隐藏参考图层
 *   - 锁定无文字底图
 */

const photoshop = require("photoshop");
const { app, core, action, constants } = photoshop;
const { storage } = require("uxp");
const fs = storage.localFileSystem;

const TEMPLATE_WIDTH = 837;
const TEMPLATE_HEIGHT = 1880;

// 所有坐标均取自已确认 PSD（837 × 1880）；左 Logo 已按右 Logo 边距修正为左右对称。
const LOGO_LAYOUT = Object.freeze({
    left:  { left: 18,  top: 33, width: 78, height: 78 },
    right: { left: 741, top: 33, width: 78, height: 78 }
});

// 标题智能对象必须保留完整源画布。副标题源画布较大，实际文字位于画布中部；
// 因此它的 left/top 看似异常，但这是保持当前 PSD 可见位置不漂移的关键。
const TITLE_LAYOUT = Object.freeze({
    main:     { left: 173, top: 135, width: 508, height: 161 },
    subtitle: { left: -15, top: 86, width: 773, height: 582 }
});

