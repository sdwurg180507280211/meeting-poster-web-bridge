let currentStage = "初始化";

function numberValue(value) {
    if (typeof value === "number") return value;
    if (value && typeof value.value === "number") return value.value;
    if (value && typeof value._value === "number") return value._value;
    const n = Number(value);
    return Number.isFinite(n) ? n : 0;
}

function makeColor(red, green, blue) {
    const SolidColor = app.SolidColor;
    const color = new SolidColor();
    color.rgb.red = red;
    color.rgb.green = green;
    color.rgb.blue = blue;
    return color;
}

function cloneColor(source) {
    return makeColor(source.rgb.red, source.rgb.green, source.rgb.blue);
}

function chooseInstalledFont(candidates) {
    for (const postScriptName of candidates) {
        try {
            const font = app.fonts.getByName(postScriptName);
            if (font) return font.postScriptName;
        } catch (_) {
            // 尝试下一个字体
        }
    }
    if (app.fonts.length > 0) return app.fonts[0].postScriptName;
    return "ArialMT";
}


function base64ToArrayBuffer(base64) {
    // 不依赖浏览器全局 atob，确保独立 PSJS 环境也可解码。
    const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    const clean = base64.replace(/\s/g, "");
    const padding = clean.endsWith("==") ? 2 : clean.endsWith("=") ? 1 : 0;
    const bytes = new Uint8Array(Math.floor(clean.length * 3 / 4) - padding);

    let accumulator = 0;
    let bits = 0;
    let outputIndex = 0;

    for (let i = 0; i < clean.length; i++) {
        const char = clean[i];
        if (char === "=") break;
        const value = alphabet.indexOf(char);
        if (value < 0) continue;

        accumulator = (accumulator << 6) | value;
        bits += 6;

        if (bits >= 8) {
            bits -= 8;
            bytes[outputIndex++] = (accumulator >> bits) & 0xff;
            accumulator &= bits === 0 ? 0 : (1 << bits) - 1;
        }
    }

    return bytes.buffer;
}

async function writeBase64Png(folder, fileName, base64) {
    const file = await folder.createFile(fileName, { overwrite: true });
    await file.write(base64ToArrayBuffer(base64), { format: storage.formats.binary });
    return file;
}

function errorDetails(error) {
    const message = error && error.message ? error.message : String(error);
    const stack = error && error.stack ? String(error.stack).split("\n").slice(0, 7).join("\n") : "";
    return `执行阶段：${currentStage}\n\n${message}${stack ? `\n\n${stack}` : ""}`;
}

async function createPlaceholderFiles() {
    currentStage = "创建临时占位素材";
    const tempFolder = await fs.getTemporaryFolder();

    const avatarFile = await tempFolder.createFile("avatar_placeholder.svg", { overwrite: true });
    const avatarSvg = `<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <rect width="512" height="512" fill="#eef1f8"/>
  <circle cx="256" cy="190" r="88" fill="#b8bfd0"/>
  <path d="M92 480c12-116 76-178 164-178s152 62 164 178" fill="#b8bfd0"/>
  <circle cx="256" cy="256" r="246" fill="none" stroke="#7b61df" stroke-width="12" stroke-dasharray="18 12"/>
</svg>`;
    await avatarFile.write(avatarSvg);

    const qrFile = await tempFolder.createFile("qr_placeholder.svg", { overwrite: true });
    const qrSvg = `<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="600" height="600" viewBox="0 0 600 600">
  <rect width="600" height="600" fill="#ffffff"/>
  <g fill="#d9dbea">
    <rect x="70" y="70" width="160" height="160"/><rect x="370" y="70" width="160" height="160"/><rect x="70" y="370" width="160" height="160"/>
    <rect x="270" y="270" width="60" height="60"/><rect x="370" y="290" width="60" height="60"/><rect x="470" y="270" width="60" height="60"/>
    <rect x="270" y="390" width="60" height="60"/><rect x="370" y="410" width="60" height="60"/><rect x="470" y="390" width="60" height="60"/>
    <rect x="290" y="490" width="60" height="60"/><rect x="410" y="490" width="60" height="60"/>
  </g>
  <g fill="none" stroke="#6a46d9" stroke-width="20">
    <rect x="40" y="40" width="220" height="220"/><rect x="340" y="40" width="220" height="220"/><rect x="40" y="340" width="220" height="220"/>
  </g>
</svg>`;
    await qrFile.write(qrSvg);

    // Logo 使用固定的正方形智能对象画布。替换相近比例的 Logo 可直接“替换内容”；
    // 横版或竖版 Logo 建议双击缩略图，在智能对象内部等比缩放后保存。
    const logoFile = await tempFolder.createFile("logo_placeholder.svg", { overwrite: true });
    const logoSvg = `<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="600" height="600" viewBox="0 0 600 600">
  <rect x="12" y="12" width="576" height="576" rx="72" fill="#ffffff" fill-opacity="0.78" stroke="#7654dc" stroke-width="16" stroke-dasharray="30 18"/>
  <circle cx="300" cy="245" r="105" fill="#ece8ff"/>
  <path d="M225 290L300 155l75 135z" fill="#7654dc" fill-opacity="0.72"/>
  <text x="300" y="430" text-anchor="middle" font-family="Arial, sans-serif" font-size="72" font-weight="700" fill="#7654dc">LOGO</text>
</svg>`;
    await logoFile.write(logoSvg);

    const mainTitleFile = await writeBase64Png(
        tempFolder,
        "main_title_medical_route_changan.png",
        MAIN_TITLE_PNG_BASE64
    );
    const subtitleFile = await writeBase64Png(
        tempFolder,
        "subtitle_chronic_disease_project.png",
        SUBTITLE_PNG_BASE64
    );

    return { avatarFile, qrFile, logoFile, mainTitleFile, subtitleFile };
}

async function selectLayerById(layerId) {
    await action.batchPlay([
        {
            _obj: "select",
            _target: [{ _ref: "layer", _id: layerId }],
            makeVisible: false,
            _options: { dialogOptions: "dontDisplay" }
        }
    ], {});
}

async function fillSelectionWithForeground() {
    await action.batchPlay([
        {
            _obj: "fill",
            using: { _enum: "fillContents", _value: "foregroundColor" },
            opacity: { _unit: "percentUnit", _value: 100 },
            mode: { _enum: "blendMode", _value: "normal" },
            _options: { dialogOptions: "dontDisplay" }
        }
    ], {});
}

async function placeEmbedded(fileEntry, layerName, targetDocument) {
    const token = fs.createSessionToken(fileEntry);
    await action.batchPlay([
        {
            _obj: "placeEvent",
            null: { _path: token, _kind: "local" },
            freeTransformCenterState: { _enum: "quadCenterState", _value: "QCSAverage" },
            offset: {
                _obj: "offset",
                horizontal: { _unit: "pixelsUnit", _value: 0 },
                vertical: { _unit: "pixelsUnit", _value: 0 }
            },
            _options: { dialogOptions: "dontDisplay" }
        }
    ], {});

    const placedLayer = targetDocument.activeLayers[0];
    placedLayer.name = layerName;
    return placedLayer;
}

function getLayerGeometry(layer) {
    const bounds = layer.boundsNoEffects || layer.bounds;
    const left = numberValue(bounds.left);
    const top = numberValue(bounds.top);
    const right = numberValue(bounds.right);
    const bottom = numberValue(bounds.bottom);
    return {
        left,
        top,
        right,
        bottom,
        width: right - left,
        height: bottom - top,
        centerX: (left + right) / 2,
        centerY: (top + bottom) / 2
    };
}

async function fitLayerIntoBox(layer, box, cover = false, interpolation = constants.InterpolationMethod.BICUBIC) {
    const geometry = getLayerGeometry(layer);
    if (geometry.width <= 0 || geometry.height <= 0) {
        throw new Error(`图层“${layer.name}”没有有效尺寸。`);
    }

    const scaleX = box.width / geometry.width;
    const scaleY = box.height / geometry.height;
    const scaleFactor = cover ? Math.max(scaleX, scaleY) : Math.min(scaleX, scaleY);
    const scalePercent = scaleFactor * 100;

    await layer.scale(
        scalePercent,
        scalePercent,
        constants.AnchorPosition.MIDDLECENTER,
        { interpolation }
    );

    const scaled = getLayerGeometry(layer);
    const targetCenterX = box.left + box.width / 2;
    const targetCenterY = box.top + box.height / 2;
    await layer.translate(targetCenterX - scaled.centerX, targetCenterY - scaled.centerY);
}

async function fitLayerExactlyToBox(layer, box, interpolation = constants.InterpolationMethod.BICUBIC) {
    const geometry = getLayerGeometry(layer);
    if (geometry.width <= 0 || geometry.height <= 0) {
        throw new Error(`图层“${layer.name}”没有有效尺寸。`);
    }

    await layer.scale(
        box.width / geometry.width * 100,
        box.height / geometry.height * 100,
        constants.AnchorPosition.MIDDLECENTER,
        { interpolation }
    );

    const scaled = getLayerGeometry(layer);
    await layer.translate(
        box.left + box.width / 2 - scaled.centerX,
        box.top + box.height / 2 - scaled.centerY
    );
}

async function createFilledEllipseLayer(document, targetGroup, name, box, fillColor) {
    const ellipseLayer = await document.createPixelLayer({ name });
    ellipseLayer.move(targetGroup, constants.ElementPlacement.PLACEINSIDE);
    await selectLayerById(ellipseLayer.id);

    const originalForeground = cloneColor(app.foregroundColor);
    try {
        app.foregroundColor = fillColor;
        await document.selection.selectEllipse(
            {
                top: box.top,
                left: box.left,
                bottom: box.top + box.height,
                right: box.left + box.width
            },
            constants.SelectionType.REPLACE,
            0,
            true
        );
        await fillSelectionWithForeground();
        await document.selection.deselect();
    } finally {
        app.foregroundColor = originalForeground;
    }
    return ellipseLayer;
}

async function placeReferenceIntoDocument(referenceEntry, targetDocument, targetGroup) {
    currentStage = "置入并隐藏参考图";
    app.activeDocument = targetDocument;

    // 直接“置入嵌入对象”，避免打开参考图后复制 Background 图层。
    // Photoshop 的特殊 Background 图层不允许改名，上一版正是在改名时失败。
    const referenceLayer = await placeEmbedded(
        referenceEntry,
        "图二_带文字参考图_隐藏",
        targetDocument
    );

    await fitLayerIntoBox(
        referenceLayer,
        {
            left: 0,
            top: 0,
            width: numberValue(targetDocument.width),
            height: numberValue(targetDocument.height)
        },
        false
    );

    referenceLayer.move(targetGroup, constants.ElementPlacement.PLACEINSIDE);
    referenceLayer.visible = false;
    return referenceLayer;
}

async function buildTemplate(executionContext, backgroundEntry, referenceEntry, saveEntry, placeholders) {
    executionContext.reportProgress({ value: 0.02, commandName: "打开无文字底图" });
    currentStage = "打开无文字底图";
    const doc = await app.open(backgroundEntry);
    app.activeDocument = doc;

    const documentWidth = numberValue(doc.width);
    const documentHeight = numberValue(doc.height);
    if (documentWidth <= 0 || documentHeight <= 0) {
        throw new Error("无法读取底图尺寸。");
    }

    // X、Y 分别缩放时，宽高比不一致会把头像圆形拉成椭圆，并让表格与参考图错位。
    const templateRatio = TEMPLATE_WIDTH / TEMPLATE_HEIGHT;
    const documentRatio = documentWidth / documentHeight;
    const ratioError = Math.abs(documentRatio / templateRatio - 1);
    if (ratioError > 0.005) {
        throw new Error(
            `底图宽高比与模板不一致。\n` +
            `模板：${TEMPLATE_WIDTH} × ${TEMPLATE_HEIGHT}\n` +
            `当前：${Math.round(documentWidth)} × ${Math.round(documentHeight)}\n\n` +
            `请先把底图裁切为相同宽高比后再运行。`
        );
    }

    const scaleX = documentWidth / TEMPLATE_WIDTH;
    const scaleY = documentHeight / TEMPLATE_HEIGHT;
    const fontScale = Math.min(scaleX, scaleY);
    const X = value => value * scaleX;
    const Y = value => value * scaleY;
    const F = value => Math.max(6, value * fontScale);

    const PURPLE = makeColor(84, 53, 214);
    const BLACK = makeColor(25, 25, 25);
    const WHITE = makeColor(255, 255, 255);

    const regularFont = chooseInstalledFont([
        "SourceHanSansCN-Regular",
        "SourceHanSansSC-Regular",
        "PingFangSC-Regular",
        "MicrosoftYaHei",
        "AdobeHeitiStd-Regular"
    ]);
    const boldFont = chooseInstalledFont([
        "SourceHanSansCN-Bold",
        "SourceHanSansSC-Bold",
        "PingFangSC-Semibold",
        "PingFangSC-Medium",
        "MicrosoftYaHei-Bold",
        "MicrosoftYaHei",
        "AdobeHeitiStd-Regular"
    ]);

    executionContext.reportProgress({ value: 0.08, commandName: "建立图层结构" });
    currentStage = "建立图层结构";

    let baseLayer = doc.layers[0];
    if (!baseLayer) throw new Error("底图文档没有可用图层。" );

    if (baseLayer.isBackgroundLayer) {
        const normalCopy = await baseLayer.duplicate();
        baseLayer.delete();
        baseLayer = normalCopy;
    }
    baseLayer.name = "图一_锁定";

    // 所有功能组都必须位于文档根级，不能嵌套在“06_无文字底图”中。
    // createLayerGroup() 会受当前活动组影响，因此每创建一组后，都立即相对一个
    // 已确认的根级锚点执行 PLACEBEFORE，将它强制提升到文档根级并固定顺序。
    // 最终图层面板从上到下：
    // 00参考 → 01Logo → 02标题 → 03头像 → 04二维码 → 05文字 → 06底图。
    const backgroundGroup = await doc.createLayerGroup({ name: "06_无文字底图" });

    // 此时 baseLayer 仍是根级图层，可作为第一个可靠的根级锚点。
    await backgroundGroup.move(baseLayer, constants.ElementPlacement.PLACEBEFORE);
    await baseLayer.move(backgroundGroup, constants.ElementPlacement.PLACEINSIDE);
    baseLayer.allLocked = true;

    async function createRootGroupAbove(name, rootAnchor) {
        const group = await doc.createLayerGroup({ name });
        // 即使 Photoshop 把新组创建在当前活动组内部，这一步也会把它移动到
        // rootAnchor 的同级位置，因此最终一定是文档根级文件夹。
        await group.move(rootAnchor, constants.ElementPlacement.PLACEBEFORE);
        return group;
    }

    const textGroup = await createRootGroupAbove("05_可编辑文字", backgroundGroup);
    const qrGroup = await createRootGroupAbove("04_二维码_可替换", textGroup);
    const avatarGroup = await createRootGroupAbove("03_头像_可替换", qrGroup);
    const titleGroup = await createRootGroupAbove("02_标题素材_可替换", avatarGroup);
    const logoGroup = await createRootGroupAbove("01_Logo_可替换_固定尺寸", titleGroup);
    const referenceGroup = await createRootGroupAbove("00_参考校验", logoGroup);

    function verifyRootGroupStructure() {
        const expected = [
            referenceGroup,
            logoGroup,
            titleGroup,
            avatarGroup,
            qrGroup,
            textGroup,
            backgroundGroup
        ];
        const rootLayers = Array.from(doc.layers);
        const rootIds = new Set(rootLayers.map(layer => layer.id));
        const nestedGroups = expected.filter(group => !rootIds.has(group.id));

        if (nestedGroups.length > 0) {
            throw new Error(
                `以下文件夹未处于 PSD 根级：${nestedGroups.map(group => group.name).join("、")}。`
            );
        }

        const indices = expected.map(group => rootLayers.findIndex(layer => layer.id === group.id));
        for (let i = 1; i < indices.length; i += 1) {
            if (indices[i] <= indices[i - 1]) {
                throw new Error(
                    "根级文件夹顺序异常。正确顺序应为：00参考、01Logo、02标题、03头像、04二维码、05文字、06底图。"
                );
            }
        }
    }

    verifyRootGroupStructure();

    executionContext.reportProgress({ value: 0.16, commandName: "置入参考图" });
    await placeReferenceIntoDocument(referenceEntry, doc, referenceGroup);

    function scaledReferenceBounds(bounds) {
        return {
            left: X(bounds[0]),
            top: Y(bounds[1]),
            right: X(bounds[2]),
            bottom: Y(bounds[3])
        };
    }

    async function pinTextLayerToReferenceBounds(layer, bounds, align) {
        if (!bounds) return;

        const geometry = getLayerGeometry(layer);
        const target = scaledReferenceBounds(bounds);
        let dx = 0;

        if (align === "center") {
            dx = (target.left + target.right) / 2 - geometry.centerX;
        } else if (align === "right") {
            dx = target.right - geometry.right;
        } else {
            dx = target.left - geometry.left;
        }

        // 以文字实际边界底部作为纵向锚点，可规避字体 API 的基线差异。
        const dy = target.bottom - geometry.bottom;
        await layer.translate(dx, dy);
    }

    const createdTextLayers = [];

    async function addText({
        name, contents, x, y, size, bold = false, color = BLACK,
        align = "left", visible = true, tracking = 0, referenceBounds = null
    }) {
        currentStage = `创建文字图层：${name}`;
        const layer = await doc.createTextLayer({
            name,
            contents,
            fontName: bold ? boldFont : regularFont,
            fontSize: F(size),
            position: { x: X(x), y: Y(y) },
            textColor: color
        });

        // Photoshop 会把新建文字层自动命名为文字内容；不能只依赖 createTextLayer 的 name 参数。
        // 先立即赋名，完成移动和定位后再赋一次，确保最终 PSD 使用稳定的语义层名。
        layer.name = name;

        try {
            layer.textItem.paragraphStyle.justification = align === "center"
                ? constants.Justification.CENTER
                : align === "right"
                    ? constants.Justification.RIGHT
                    : constants.Justification.LEFT;
        } catch (_) {
            // 不影响文字图层创建；后续仍按参考边界二次校正位置。
        }

        try {
            layer.textItem.characterStyle.tracking = tracking;
            layer.textItem.characterStyle.antiAliasMethod = constants.AntiAlias.SHARP;
        } catch (_) {
            // 某些字体属性在个别版本中可能不可写。
        }

        layer.move(textGroup, constants.ElementPlacement.PLACEINSIDE);
        await pinTextLayerToReferenceBounds(layer, referenceBounds, align);
        layer.visible = visible;
        layer.name = name;
        createdTextLayers.push({ layer, expectedName: name });
        return layer;
    }

    function verifyTextLayerNames() {
        const expectedNames = createdTextLayers.map(item => item.expectedName);
        const expectedSet = new Set(expectedNames);
        if (expectedSet.size !== expectedNames.length) {
            throw new Error("脚本内部文字图层语义名称存在重复，已停止保存。");
        }

        const textLayers = Array.from(textGroup.layers);
        const actualNames = textLayers.map(layer => layer.name);
        const missing = expectedNames.filter(name => !actualNames.includes(name));
        const duplicated = actualNames.filter((name, index) => actualNames.indexOf(name) !== index);
        const wrongKind = createdTextLayers
            .filter(item => item.layer.kind !== constants.LayerKind.TEXT)
            .map(item => item.expectedName);

        if (createdTextLayers.length !== 37 || missing.length || duplicated.length || wrongKind.length) {
            const details = [];
            if (createdTextLayers.length !== 37) details.push(`应创建 37 个原生文字层，实际记录 ${createdTextLayers.length} 个`);
            if (missing.length) details.push(`缺少语义层名：${missing.join("、")}`);
            if (duplicated.length) details.push(`存在重复层名：${Array.from(new Set(duplicated)).join("、")}`);
            if (wrongKind.length) details.push(`以下层不是文字层：${wrongKind.join("、")}`);
            throw new Error(`文字图层命名校验失败：\n${details.join("\n")}`);
        }
    }

    executionContext.reportProgress({ value: 0.22, commandName: "创建可编辑文字" });

    // 区域标题
    await addText({ name: "标题_会议主席", contents: "会议主席", x: 418.5, y: 460, size: 34, bold: true, color: PURPLE, align: "center", tracking: 40, referenceBounds: [352, 427, 485, 460] });
    await addText({ name: "标题_会议讲者", contents: "会议讲者", x: 418.5, y: 807, size: 34, bold: true, color: PURPLE, align: "center", tracking: 40, referenceBounds: [352, 772, 486, 805] });
    await addText({ name: "标题_会议日程", contents: "会议日程", x: 418.5, y: 1140, size: 34, bold: true, color: PURPLE, align: "center", tracking: 40, referenceBounds: [352, 1103, 486, 1136] });

    // 主席与讲者信息
    await addText({ name: "主席姓名", contents: "姓  名 教授", x: 422, y: 710, size: 23, bold: true, align: "center", tracking: 90, referenceBounds: [362, 682, 476, 704] });
    await addText({ name: "主席医院", contents: "XXXXXXXXXXXX医院", x: 422, y: 732, size: 16, align: "center", referenceBounds: [341, 717, 496, 733] });

    await addText({ name: "讲者一姓名", contents: "姓  名 教授", x: 298, y: 1046, size: 22, bold: true, align: "center", tracking: 80, referenceBounds: [247, 1018, 356, 1040] });
    await addText({ name: "讲者一医院", contents: "XXXXXXXXXXXX医院", x: 298, y: 1067, size: 15, align: "center", referenceBounds: [223, 1044, 378, 1060] });
    await addText({ name: "讲者二姓名", contents: "姓  名 教授", x: 538, y: 1046, size: 22, bold: true, align: "center", tracking: 80, referenceBounds: [494, 1017, 603, 1039] });
    await addText({ name: "讲者二医院", contents: "XXXXXXXXXXXX医院", x: 538, y: 1067, size: 15, align: "center", referenceBounds: [470, 1044, 625, 1060] });

    // 时间地点
    await addText({ name: "会议时间", contents: "会议时间：2025年03月00日", x: 82, y: 1181, size: 24, bold: true, align: "left", referenceBounds: [82, 1159, 360, 1181] });
    await addText({ name: "会议地点", contents: "会议地点：线上", x: 82, y: 1220, size: 24, bold: true, align: "left", referenceBounds: [82, 1198, 235, 1220] });

    // 表头
    await addText({ name: "表头_时间", contents: "时间", x: 121, y: 1270, size: 25, bold: true, color: WHITE, align: "center", referenceBounds: [102, 1243, 147, 1266] });
    await addText({ name: "表头_内容", contents: "内容", x: 292.5, y: 1270, size: 25, bold: true, color: WHITE, align: "center", referenceBounds: [272, 1243, 317, 1266] });
    await addText({ name: "表头_讲者", contents: "讲者", x: 522.5, y: 1270, size: 25, bold: true, color: WHITE, align: "center", referenceBounds: [498, 1244, 544, 1267] });
    await addText({ name: "表头_主席", contents: "主席", x: 675, y: 1270, size: 25, bold: true, color: WHITE, align: "center", referenceBounds: [658, 1244, 704, 1267] });

    // 第一行
    await addText({ name: "第一行_时间", contents: "00:00-00:00", x: 148, y: 1331, size: 20, align: "center", referenceBounds: [89, 1310, 201, 1325] });
    await addText({ name: "第一行_圆点", contents: "●", x: 231, y: 1331, size: 15, bold: true, color: PURPLE, align: "center", referenceBounds: [232, 1313, 240, 1321] });
    await addText({ name: "第一行_内容", contents: "开场致辞", x: 261, y: 1331, size: 20, align: "left", referenceBounds: [264, 1310, 339, 1328] });
    await addText({ name: "第一行_讲者", contents: "xxx 教授", x: 530.5, y: 1331, size: 20, align: "center", referenceBounds: [485, 1308, 558, 1326] });
    await addText({ name: "第一行_主席", contents: "xxx 教授", x: 677.5, y: 1331, size: 20, align: "center", referenceBounds: [644, 1307, 717, 1325] });

    // 第二行
    await addText({ name: "第二行_时间", contents: "00:00-00:00", x: 148, y: 1395, size: 20, align: "center", referenceBounds: [89, 1375, 201, 1390] });
    await addText({ name: "第二行_圆点", contents: "●", x: 231, y: 1395, size: 15, bold: true, color: PURPLE, align: "center", referenceBounds: [232, 1378, 240, 1386] });
    await addText({ name: "第二行_内容", contents: "xxxxx", x: 261, y: 1395, size: 20, align: "left", referenceBounds: [263, 1377, 312, 1387] });
    await addText({ name: "第二行_讲者", contents: "xxx 教授", x: 530.5, y: 1395, size: 20, align: "center", referenceBounds: [485, 1374, 558, 1392] });
    await addText({ name: "第二行_主席_默认隐藏", contents: "xxx 教授", x: 677.5, y: 1395, size: 20, align: "center", visible: false, referenceBounds: [644, 1384, 717, 1402] });

    // 第三行
    await addText({ name: "第三行_时间", contents: "00:00-00:00", x: 148, y: 1459, size: 20, align: "center", referenceBounds: [89, 1440, 201, 1455] });
    await addText({ name: "第三行_圆点", contents: "●", x: 231, y: 1459, size: 15, bold: true, color: PURPLE, align: "center", referenceBounds: [232, 1443, 240, 1451] });
    await addText({ name: "第三行_内容", contents: "xxxxx", x: 261, y: 1459, size: 20, align: "left", referenceBounds: [263, 1444, 312, 1454] });
    await addText({ name: "第三行_讲者", contents: "xxx 教授", x: 530.5, y: 1459, size: 20, align: "center", referenceBounds: [485, 1438, 558, 1456] });
    await addText({ name: "第三行_主席_默认隐藏", contents: "xxx 教授", x: 677.5, y: 1459, size: 20, align: "center", visible: false, referenceBounds: [644, 1449, 717, 1467] });

    // 第四行
    await addText({ name: "第四行_时间", contents: "00:00-00:00", x: 148, y: 1524, size: 20, align: "center", referenceBounds: [89, 1505, 201, 1520] });
    await addText({ name: "第四行_圆点_默认隐藏", contents: "●", x: 231, y: 1524, size: 15, bold: true, color: PURPLE, align: "center", visible: false, referenceBounds: [232, 1519, 240, 1527] });
    await addText({ name: "第四行_内容", contents: "会议总结", x: 261, y: 1524, size: 20, align: "left", referenceBounds: [263, 1503, 338, 1521] });
    await addText({ name: "第四行_讲者_默认隐藏", contents: "xxx 教授", x: 530.5, y: 1524, size: 20, align: "center", visible: false, referenceBounds: [485, 1514, 558, 1532] });
    await addText({ name: "第四行_主席", contents: "xxx 教授", x: 677.5, y: 1524, size: 20, align: "center", referenceBounds: [644, 1503, 717, 1521] });

    await addText({ name: "排名说明", contents: "*排名不分先后,以姓名首字母拼音进行排序", x: 620, y: 1575, size: 13, align: "center", referenceBounds: [506, 1558, 750, 1571] });
    await addText({ name: "二维码说明", contents: "请扫描二维码观看会议直播", x: 418.5, y: 1768, size: 17, bold: true, color: WHITE, align: "center", referenceBounds: [0, 1746, 837, 1762] });

    executionContext.reportProgress({ value: 0.66, commandName: "创建主标题与副标题智能对象" });
    currentStage = "创建标题智能对象";

    async function createTitleSmartObject(fileEntry, name, layout) {
        const titleLayer = await placeEmbedded(fileEntry, name, doc);
        await fitLayerExactlyToBox(
            titleLayer,
            {
                left: X(layout.left),
                top: Y(layout.top),
                width: X(layout.width),
                height: Y(layout.height)
            }
        );
        titleLayer.move(titleGroup, constants.ElementPlacement.PLACEINSIDE);
        return titleLayer;
    }

    // 先放副标题、再放主标题，确保主标题位于副标题之上。
    await createTitleSmartObject(
        placeholders.subtitleFile,
        "02_副标题_慢性病规范诊疗交流项目_智能对象_可替换",
        TITLE_LAYOUT.subtitle
    );
    await createTitleSmartObject(
        placeholders.mainTitleFile,
        "01_主标题_医路长安_智能对象_可替换",
        TITLE_LAYOUT.main
    );

    executionContext.reportProgress({ value: 0.72, commandName: "创建可替换头像" });

    async function createAvatar(name, centerX, centerY, diameter) {
        currentStage = `创建头像智能对象：${name}`;
        const subGroup = await doc.createLayerGroup({ name: `${name}_可替换` });
        subGroup.move(avatarGroup, constants.ElementPlacement.PLACEINSIDE);

        // 下层圆形像素层用于裁切；智能对象作为剪贴层放在其上方
        const circleLayer = await doc.createPixelLayer({ name: "圆形裁切底层_勿删" });
        circleLayer.move(subGroup, constants.ElementPlacement.PLACEINSIDE);
        await selectLayerById(circleLayer.id);

        const left = X(centerX - diameter / 2);
        const top = Y(centerY - diameter / 2);
        const right = X(centerX + diameter / 2);
        const bottom = Y(centerY + diameter / 2);

        const originalForeground = cloneColor(app.foregroundColor);
        try {
            app.foregroundColor = WHITE;
            await doc.selection.selectEllipse(
                { top, left, bottom, right },
                constants.SelectionType.REPLACE,
                0,
                true
            );
            await fillSelectionWithForeground();
            await doc.selection.deselect();
        } finally {
            app.foregroundColor = originalForeground;
        }

        const smartLayer = await placeEmbedded(
            placeholders.avatarFile,
            `${name}_内容_双击或右键替换`,
            doc
        );
        await fitLayerIntoBox(
            smartLayer,
            { left, top, width: right - left, height: bottom - top },
            true
        );
        smartLayer.move(subGroup, constants.ElementPlacement.PLACEINSIDE);
        smartLayer.bringToFront();
        try {
            smartLayer.isClippingMask = true;
        } catch (_) {
            // 少数版本用动作系统建立剪贴蒙版更稳定。
            await selectLayerById(smartLayer.id);
            await action.batchPlay([
                {
                    _obj: "groupEvent",
                    _options: { dialogOptions: "dontDisplay" }
                }
            ], {});
        }
        return smartLayer;
    }

    await createAvatar("主席头像", 426, 580, 168);
    await createAvatar("讲者一头像", 303.5, 918.5, 165);
    await createAvatar("讲者二头像", 539, 918, 164);

    executionContext.reportProgress({ value: 0.86, commandName: "创建固定尺寸可替换 Logo" });
    currentStage = "创建固定尺寸 Logo 智能对象";

    async function createReplaceableLogo(name, layout) {
        const box = {
            left: X(layout.left),
            top: Y(layout.top),
            width: X(layout.width),
            height: Y(layout.height)
        };

        const subGroup = await doc.createLayerGroup({ name: `${name}_可替换` });
        subGroup.move(logoGroup, constants.ElementPlacement.PLACEINSIDE);

        // 用下层固定尺寸圆形作为裁切底层；上方 Logo 智能对象作为剪贴蒙版。
        // 这样替换内容后，仍可直接对智能对象做自由变换和位移，裁切效果更稳定。
        const frameLayer = await createFilledEllipseLayer(
            doc,
            subGroup,
            "固定圆形裁切框_78x78_勿删",
            box,
            WHITE
        );

        const logoLayer = await placeEmbedded(
            placeholders.logoFile,
            `${name}_内容_右键替换后可缩放位移_圆形裁切`,
            doc
        );
        // 默认等比完整显示，不做拉伸。需要铺满时，可替换后手动放大。
        await fitLayerIntoBox(logoLayer, box, false, constants.InterpolationMethod.BICUBIC);
        logoLayer.move(subGroup, constants.ElementPlacement.PLACEINSIDE);
        logoLayer.bringToFront();
        try {
            logoLayer.isClippingMask = true;
        } catch (_) {
            await selectLayerById(logoLayer.id);
            await action.batchPlay([
                {
                    _obj: "groupEvent",
                    _options: { dialogOptions: "dontDisplay" }
                }
            ], {});
        }
        return { subGroup, frameLayer, logoLayer };
    }

    await createReplaceableLogo(
        "左上角Logo_固定78x78",
        LOGO_LAYOUT.left
    );
    await createReplaceableLogo(
        "右上角Logo_固定78x78",
        LOGO_LAYOUT.right
    );

    executionContext.reportProgress({ value: 0.91, commandName: "创建可替换二维码" });
    currentStage = "创建二维码智能对象";
    const qrLayer = await placeEmbedded(placeholders.qrFile, "二维码图片_可替换", doc);
    const qrBox = {
        left: X(338),
        top: Y(1576),
        width: X(148),
        height: Y(148)
    };
    // 二维码禁用双三次插值，避免模块边缘发虚影响扫描。
    await fitLayerIntoBox(
        qrLayer,
        qrBox,
        false,
        constants.InterpolationMethod.NEARESTNEIGHBOR
    );
    qrLayer.move(qrGroup, constants.ElementPlacement.PLACEINSIDE);

    executionContext.reportProgress({ value: 0.97, commandName: "校验并保存分层 PSD" });
    currentStage = "校验根级文件夹结构";
    verifyRootGroupStructure();
    currentStage = "校验文字图层语义命名";
    verifyTextLayerNames();

    currentStage = "保存分层 PSD";
    await doc.saveAs.psd(saveEntry, { embedColorProfile: true }, false);

    executionContext.reportProgress({ value: 1.0, commandName: "完成" });
    return {
        width: documentWidth,
        height: documentHeight,
        regularFont,
        boldFont
    };
}

const backgroundEntry = await fs.getFileForOpening({ types: ["png", "jpg", "jpeg"] });
if (!backgroundEntry) {
    await app.showAlert("已取消：未选择无文字底图。");
} else {
    const referenceEntry = await fs.getFileForOpening({ types: ["png", "jpg", "jpeg"] });
    if (!referenceEntry) {
        await app.showAlert("已取消：未选择带文字参考图。");
    } else {
        const saveEntry = await fs.getFileForSaving("会议海报模板.psd", { types: ["psd"] });
        if (!saveEntry) {
            await app.showAlert("已取消：未选择 PSD 保存位置。");
        } else {
            try {
                const placeholders = await createPlaceholderFiles();
                const result = await core.executeAsModal(
                    executionContext => buildTemplate(
                        executionContext,
                        backgroundEntry,
                        referenceEntry,
                        saveEntry,
                        placeholders
                    ),
                    { commandName: "生成会议海报 PSD 模板" }
                );

                await app.showAlert(
                    `PSD 模板 v10 已生成。\n\n` +
                    `画布：${Math.round(result.width)} × ${Math.round(result.height)} px\n` +
                    `正文字体：${result.regularFont}\n` +
                    `粗体字体：${result.boldFont}\n\n` +
                    `Logo：外层显示区域固定为 78 × 78 px；右键“替换内容”后，可直接对 Logo 智能对象缩放/位移，圆形裁切会自动生效。\n` +
                    `标题：主标题与副标题均为独立智能对象，可双击编辑或右键替换。\n` +
                    `头像：双击“头像内容”智能对象，或右键选择“替换内容”。\n` +
                    `二维码：右键“二维码图片_可替换”并选择“替换内容”。`
                );
            } catch (error) {
                console.error(error);
                await app.showAlert(`脚本执行失败：\n\n${errorDetails(error)}`);
            }
        }
    }
}
