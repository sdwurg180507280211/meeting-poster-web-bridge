SUPABASE_URL=https://xkuzzmqtboclgvkvdlwd.supabase.co
SUPABASE_SECRET_KEY=YOUR_SB_SECRET_KEY
# 兼容旧项目：如果没有 sb_secret_...，也可改用 SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_BUCKET=poster-assets
WORKSPACE_DIR=/Users/YOUR_MAC_USERNAME/MeetingPosterAgent
POLL_MS=2000
AGENT_ID=my-mac-photoshop
# 生产默认 false，任务上传成功后清理 inbox/outbox；仅排查问题时临时改为 true。
KEEP_LOCAL_JOBS=false

# 单个输入素材的上限；只能下调，代码中的硬上限为 15728640（15 MiB）。
MAX_INPUT_BYTES=15728640
# 防止异常本地输出一次占用过多内存；PSD/PNG 不受输入素材的 15 MiB 限制。
MAX_OUTPUT_BYTES=1073741824

# 任务租约与自动恢复。认领 15 分钟，进入 Photoshop 后 30 分钟并由健康 Worker 定期续约。
CLAIM_LEASE_SECONDS=900
RENDER_LEASE_SECONDS=1800
STALE_AFTER_SECONDS=1800
MAX_JOB_ATTEMPTS=3
RECOVERY_INTERVAL_MS=60000
LEASE_RENEW_INTERVAL_MS=60000
WORKER_HEARTBEAT_MAX_AGE_MS=120000
